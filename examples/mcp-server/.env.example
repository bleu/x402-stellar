# The buyer's Stellar secret key. Stays in this file: the MCP client config
# never carries it, so the config can be shared or shown on screen safely.
STELLAR_PRIVATE_KEY=S...

# stellar:testnet or stellar:pubnet
STELLAR_NETWORK=stellar:testnet

# The Bazaar this server searches. The only endpoint it is told about; every
# other URL it uses comes from the catalog.
FACILITATOR_URL=http://localhost:4022

# Spending limits, in whole USD-pegged tokens.
MAX_PAYMENT=0.01
SESSION_BUDGET=0.05

# Assets this wallet will sign for: network|contract|decimals|symbol, comma
# separated. Anything not listed is refused with asset_not_allowed. Defaults to
# testnet USDC.
# PAYABLE_ASSETS=stellar:testnet|CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA|7|USDC

# fatal, error, warn, info, debug, trace. Logs go to stderr, never stdout.
LOG_LEVEL=info
