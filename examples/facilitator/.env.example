# Facilitator
FACILITATOR_STELLAR_PRIVATE_KEY=S_YOUR_FACILITATOR_PRIVATE_KEY_HERE
PORT=4022

# Stellar
STELLAR_NETWORK=stellar:testnet
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# upto scheme (optional)
# When set to a deployed UptoSettlement contract id, the facilitator also serves
# the upto scheme (partial settlement up to a signed cap). See contracts/.
# UPTO_CONTRACT_ID=C_YOUR_UPTO_SETTLEMENT_CONTRACT_ID

# upto end-to-end proof (optional, `pnpm upto-e2e`)
# Only this script needs them: it plays the buyer as well as the facilitator,
# so it needs a buyer key and a recipient the service itself never handles.
# CAP and ACTUAL are atomic units; the defaults settle 0.4 against a 1.0 ceiling.
# BUYER_SECRET=S_YOUR_BUYER_SECRET_HERE
# MERCHANT_ADDRESS=G_YOUR_MERCHANT_ADDRESS_HERE
# CAP=10000000
# ACTUAL=4000000

# Catalog module (optional)
# When set, resources that settle while declaring the bazaar discovery extension
# are recorded in Postgres and served at GET /discovery/resources and
# GET /discovery/search. Needs pgvector; start a local instance with:
#   docker compose up -d postgres
# Then optionally load the demo corpus with: pnpm seed-catalog
# DATABASE_URL=postgres://facilitator:facilitator@localhost:5442/facilitator

# USD price feed (optional)
# A CoinGecko demo key switches on the maxUsdPrice search filter. Without it,
# search reports that the filter could not be applied rather than dropping
# results silently. Polled every 15 minutes in one batched call.
# COINGECKO_API_KEY=your-coingecko-demo-key

# High-throughput mode (optional)
# Use a separate fee-bump signer and channel accounts for parallel tx submission.
# Run: pnpm generate-channel-accounts  (to generate and fund these on testnet)
# FACILITATOR_STELLAR_FEE_BUMP_SECRET=S_YOUR_FEE_BUMP_SECRET_HERE
# FACILITATOR_STELLAR_CHANNEL_SECRETS=S_CHANNEL_1,S_CHANNEL_2,...,S_CHANNEL_N

# Transaction fee cap (stroops). The @x402/stellar library default is 50,000
# but Soroban resource fees can exceed that. Set higher if clients get
# "fee_exceeds_maximum" errors.
# MAX_TRANSACTION_FEE_STROOPS=100000

# Security
# TRUST_PROXY=loopback,linklocal,uniquelocal
# CORS_ORIGINS=http://localhost:3001
# Optional: Bearer token that clients must send in Authorization header.
# When unset the facilitator is open (suitable for local/private networks only).
# FACILITATOR_API_KEY=your-secret-key-here
